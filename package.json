{
  "type": "module",
  "scripts": {
    "lint": "npm run lint:css && npm run lint:js && npm run lint:editorconfig && npm run lint:php && npm run lint:phpstan",
    "lint:fix": "npm run lint:css-fix && npm run lint:js-fix && npm run lint:php-fix",
    "lint:css": "stylelint \"packages/ps14_site/Resources/Private/Assets/**/*.{scss,css,sass}\"",
    "lint:css-fix": "stylelint \"packages/ps14_site/Resources/Private/Assets/**/*.{scss,css,sass}\" --fix",
    "lint:js": "eslint .",
    "lint:js-fix": "eslint . --fix",
    "lint:editorconfig": "editorconfig-checker && editorconfig-checker packages/ps14_site packages/ps14_foundation",
    "lint:php": "vendor/bin/php-cs-fixer check --diff",
    "lint:php-fix": "vendor/bin/php-cs-fixer fix",
    "lint:phpstan": "vendor/bin/phpstan analyse --no-progress"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "editorconfig-checker": "^7.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "sass-embedded": "^1.89.1",
    "stylelint": "^16.21.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "vite": "^7.1.3",
    "vite-plugin-typo3": "^2.1.0",
    "webfont": "^12.5.0"
  }
}
