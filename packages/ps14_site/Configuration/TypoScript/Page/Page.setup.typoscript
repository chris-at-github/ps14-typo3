page {
  10 {
    layoutRootPaths {
      20 = EXT:ps14_site/Resources/Private/Layouts/Page/
    }

    templateRootPaths {
      20 = EXT:ps14_site/Resources/Private/Templates/Page/
    }

    partialRootPaths {
      20 = EXT:ps14_site/Resources/Private/Partials/
    }

    variables {
      // Seiten-Layout "Produkt" (pages.layout = 4)
      pageLayout {
        4 = TEXT
        4.value = Product
      }
    }

    dataProcessing {
      150 = TYPO3\CMS\Frontend\DataProcessing\SiteProcessor

      // Logo-Leiste im Footer (Inhaltselement mit Kennung "tisax-certification", Ausgabe in Partials/Page/Layout/Footer.html)
      160 = database-query
      160 {
        table = tt_content
        pidInList.data = site:rootPageId
        recursive = 99
        where = tx_foundation_identifier = 'tisax-certification'
        max = 1
        as = footerLogos

        dataProcessing {
          10 = files
          10 {
            references.fieldName = image
            as = images
          }
        }
      }
    }
  }
}
