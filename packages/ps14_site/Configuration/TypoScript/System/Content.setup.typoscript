// ---------------------------------------------------------------------------------------------------------------------
// Ueberschreiben des Standard Content Elements
lib.contentElement {
  layoutRootPaths {
    110 = EXT:ps14_site/Resources/Private/Layouts/Content/
  }

  templateRootPaths {
    110 = EXT:ps14_site/Resources/Private/Templates/Content/
  }

  partialRootPaths {
    110 = EXT:ps14_site/Resources/Private/Partials/
  }

  // Rahmen-Klassen (ce-frame--*) und Attribute fuer Layouts/Content/Default.html
  dataProcessing {
    100 = Ps14\Site\DataProcessing\ContentElementProcessor
  }
}
