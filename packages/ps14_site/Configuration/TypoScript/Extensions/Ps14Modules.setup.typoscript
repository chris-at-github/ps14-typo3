@import 'EXT:ps14_modules/Configuration/TypoScript/setup.typoscript'

// ---------------------------------------------------------------------------------------------------------------------
// Akkordeon mit KIST-Markup
tt_content.ps14_accordion {
  templateRootPaths {
    110 = EXT:ps14_site/Resources/Private/Extensions/Ps14Modules/Templates/Content/
  }

  partialRootPaths {
    110 = EXT:ps14_site/Resources/Private/Extensions/Ps14Modules/Partials/
  }
}

// ---------------------------------------------------------------------------------------------------------------------
// Tabs und Timeline mit KIST-Markup
tt_content.ps14_tabs {
  templateRootPaths.110 = EXT:ps14_site/Resources/Private/Extensions/Ps14Modules/Templates/Content/
  partialRootPaths.110 = EXT:ps14_site/Resources/Private/Extensions/Ps14Modules/Partials/
}

tt_content.ps14_timeline {
  templateRootPaths.110 = EXT:ps14_site/Resources/Private/Extensions/Ps14Modules/Templates/Content/
  partialRootPaths.110 = EXT:ps14_site/Resources/Private/Extensions/Ps14Modules/Partials/

  settings.media {
    maxHeight = 300
    cropVariant = default
    mediaQueries {
      992 {
        maxHeight = 300
        cropVariant = default
        mediaQuery = (min-width: 992px)
      }

      576 {
        maxHeight = 200
        cropVariant = default
        mediaQuery = (min-width: 576px)
      }

      0 {
        maxWidth = 490
        cropVariant = default
        mediaQuery = (min-width: 0px)
      }
    }
  }
}
