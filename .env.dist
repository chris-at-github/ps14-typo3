# Template for the environment file `.env` on staging and production.
#
# Copy it to `shared/.env` on the server and set the values of the stage.
# `.env` is git-ignored and must never be committed (it may hold secrets).
# Locally, DDEV creates `.env` from `.env.ddev` on `ddev start`.
#
# Loaded by helhum/dotenv-connector when vendor/autoload.php is included,
# before TYPO3 boots. Real environment variables take precedence.
# Usable in the site configuration (`%env(NAME)%`) and TypoScript (getEnv).

# TYPO3 application context: Production, Production/Staging, Development
TYPO3_CONTEXT=Production
