{
    "name": "typo3/cms-base-distribution",
    "description": "TYPO3 CMS Base Distribution",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "config": {
        "allow-plugins": {
            "a9f/fractor-extension-installer": true,
            "helhum/dotenv-connector": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "require-dev": {
        "a9f/typo3-fractor": "^1.0",
        "deployer/deployer": "^7.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "ps14/ps14_migration": "^14.0@dev",
        "saschaegerer/phpstan-typo3": "^3.0",
        "ssch/typo3-rector": "^3.14",
        "typo3/coding-standards": "^0.9.0"
    },
    "require": {
        "b13/container": "^4.1",
        "friendsoftypo3/content-blocks": "^2.4",
        "friendsoftypo3/tt-address": "^10.0",
        "helhum/dotenv-connector": "^3.0",
        "in2code/in2mcp": "^2.4",
        "praetorius/vite-asset-collector": "^1.18",
        "ps14/ps14_address": "^14.0@dev",
        "ps14/ps14_component": "^14.0@dev",
        "ps14/ps14_container": "^14.0@dev",
        "ps14/ps14_downloads": "^14.0@dev",
        "ps14/ps14_foundation": "^14.0@dev",
        "ps14/ps14_menu": "^14.0@dev",
        "ps14/ps14_modules": "^14.0@dev",
        "ps14/ps14_site": "^14.0@dev",
        "ps14/ps14_textmedia": "^14.0@dev",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-belog": "^14.3",
        "typo3/cms-beuser": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-dashboard": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-felogin": "^14.3",
        "typo3/cms-filelist": "^14.3",
        "typo3/cms-filemetadata": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-form": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-impexp": "^14.3",
        "typo3/cms-info": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-reactions": "^14.3",
        "typo3/cms-recycler": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-seo": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-sys-note": "^14.3",
        "typo3/cms-tstemplate": "^14.3",
        "typo3/cms-viewpage": "^14.3",
        "typo3/cms-webhooks": "^14.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "ps14/ps14_address": "14.x-dev",
                    "ps14/ps14_component": "14.x-dev",
                    "ps14/ps14_container": "14.x-dev",
                    "ps14/ps14_downloads": "14.x-dev",
                    "ps14/ps14_foundation": "14.x-dev",
                    "ps14/ps14_menu": "14.x-dev",
                    "ps14/ps14_modules": "14.x-dev",
                    "ps14/ps14_site": "14.x-dev",
                    "ps14/ps14_textmedia": "14.x-dev"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-address.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-component.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-container.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-downloads.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-foundation.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-menu.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-modules.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chris-at-github/ps14-textmedia.git"
        }
    ],
    "prefer-stable": true,
    "extra": {
        "helhum/dotenv-connector": {
            "env-dir": ".",
            "env-file-name": ".env",
            "allow-overrides": false
        }
    }
}
